{
    "name": "szwtdl/storage",
    "description": "阿里云，腾讯云，七牛云，对象存储，支持laravel",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Szwtdl\\": "src/"
        }
    },
    "authors": [
        {
            "name": "szwtdl",
            "email": "szpengjian@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "aliyuncs/oss-sdk-php": "^2.7",
        "qcloud/cos-sdk-v5": "^2.6",
        "qiniu/php-sdk": "^7.2",
        "qcloud_sts/qcloud-sts-sdk": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.10",
        "mockery/mockery": "^1.4.4",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^9.5",
        "jetbrains/phpstorm-attributes": "^1.0"
    },
    "psr-4": {
        "Tests\\": "tests/"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Szwtdl\\Storage\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
